{
  "name": "farmacia",
  "version": "1.0.0",
  "description": "Aplicativo FarmaciaApp",
  "author": "Félix",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"yarn backend\" \"yarn frontend\" \"yarn electron:dev\"",
    "backend": "cross-env NODE_ENV=development node backend/server.js",
    "frontend": "cd frontend && cross-env NODE_ENV=development vite",
    "electron:dev": "wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .",
    "build:ui": "cd frontend && npm run build",
    "build:app": "electron-builder"
  },
  "build": {
    "appId": "com.felix.farmacia",
    "productName": "FarmaciaApp",
    "directories": {
      "output": "dist"
    },
    "files": [
      "backend/**/*",
      "frontend/dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend/database.sqlite",
        "to": "database.sqlite"
      }
    ],
    "win": {
      "target": ["nsis", "portable"]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.3",
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.3",
    "electron": "^38.1.1",
    "electron-builder": "^24.0.0",
    "vite": "^7.1.5",
    "wait-on": "^7.0.1"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  }
}



























